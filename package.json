{
  "name": "rvkfoodie",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "check": "vite build && tsc --noEmit",
    "cf-typegen": "wrangler types",
    "postinstall": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply rvkfoodie-cms-v4b --local",
    "db:migrate:remote": "wrangler d1 migrations apply rvkfoodie-cms-v4b --remote",
    "db:seed": "wrangler d1 execute rvkfoodie-cms-v4b --local --file scripts/seed.sql",
    "db:seed:remote": "wrangler d1 execute rvkfoodie-cms-v4b --remote --file scripts/seed.sql",
    "test:rpc": "tsx scripts/rpc-e2e.test.ts"
  },
  "dependencies": {
    "@cloudflare/kumo": "^2.9.0",
    "@formisch/react": "1.0.0-rc.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-start": "^1.168.34",
    "agent-cms": "0.4.5",
    "better-auth": "^1.6.25",
    "better-result": "^3.0.0",
    "datocms-structured-text-to-html-string": "^5.1.16",
    "drizzle-orm": "1.0.0-rc.4",
    "fractional-indexing": "^4.0.0",
    "gql.tada": "^1.11.3",
    "graphql": "^17.0.2",
    "leaflet": "^1.9.4",
    "qrcode": "^1.5.4",
    "react": "~19.2.4",
    "react-dom": "~19.2.4",
    "result-rpc": "^0.3.0",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@0no-co/graphqlsp": "^1.17.3",
    "@cloudflare/vite-plugin": "^1.50.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "drizzle-kit": "1.0.0-rc.4",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.0",
    "wrangler": "^4.118.0"
  }
}
