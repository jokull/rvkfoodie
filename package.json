{
  "name": "rvkfoodie",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "check": "vite build && tsc --noEmit",
    "cf-typegen": "wrangler types",
    "postinstall": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply rvkfoodie-cms-v4b --local",
    "db:migrate:remote": "wrangler d1 migrations apply rvkfoodie-cms-v4b --remote",
    "db:seed": "wrangler d1 execute rvkfoodie-cms-v4b --local --file scripts/seed.sql",
    "db:seed:remote": "wrangler d1 execute rvkfoodie-cms-v4b --remote --file scripts/seed.sql"
  },
  "dependencies": {
    "@paralleldrive/cuid2": "^3.3.0",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-start": "^1.168.34",
    "drizzle-orm": "1.0.0-rc.4",
    "fractional-indexing": "^4.0.0",
    "react": "~19.2.4",
    "react-dom": "~19.2.4",
    "result-rpc": "^0.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.50.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "drizzle-kit": "1.0.0-rc.4",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.2.0",
    "wrangler": "^4.118.0"
  }
}
