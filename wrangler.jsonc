{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rvkfoodie",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rvkfoodie-cms-v4b",
      "database_id": "a243733a-4334-43d6-b22b-fc90ad2fc371",
      "migrations_dir": "drizzle",
      "migrations_pattern": "drizzle/*/migration.sql"
    }
  ],

  // Email binding — send_email is in beta (remote deploy requires the beta
  // grant; local emulation works without it). No destination restriction:
  // the guide-capture flow sends to arbitrary guest emails. The from-address
  // (guides@rvkfoodie.is) needs domain verification for production.
  "send_email": [{ "name": "EMAIL" }],

  // Public Turnstile site key — add the rvkfoodie.is hostname to the site in
  // the Turnstile dashboard, then put the key here (and add localhost too for
  // dev, or use a Turnstile test site key). The SECRET key goes in .dev.vars
  // locally and `wrangler secret put TURNSTILE_SECRET_KEY` in production.
  "vars": {
    "TURNSTILE_SITE_KEY": "",
    "TURNSTILE_SECRET_KEY": ""
  }
}
