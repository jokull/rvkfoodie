{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rvkfoodie",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rvkfoodie-cms-v4b",
      "database_id": "a243733a-4334-43d6-b22b-fc90ad2fc371",
      "migrations_dir": "drizzle",
      "migrations_pattern": "drizzle/*/migration.sql"
    }
  ],

  // Media bucket — the legacy rvkfoodie-cms bucket behind media.rvkfoodie.is
  // (custom domain + Image Resizing). Uploads land here; photos store the
  // raw CDN URLs and renderers append cdn-cgi/image options.
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "rvkfoodie-cms" }],

  // Email binding — send_email is in beta (remote deploy requires the beta
  // grant; local emulation works without it). No destination restriction:
  // the guide-capture flow sends to arbitrary guest emails. The from-address
  // (guides@rvkfoodie.is) needs domain verification for production.
  "send_email": [{ "name": "EMAIL" }],

  // Consumer-store bindings (agent-cms read path + Gumroad unlocks). The
  // same worker that serves the internal /app SPA serves the public
  // consumer site: agent-cms runs in-process against the shared D1, its
  // images live in the legacy R2 bucket, and purchases unlock via KV.
  "kv_namespaces": [
    {
      "binding": "PURCHASES",
      "id": "782842e31e944c38af1413c73fdcced2"
    }
  ],
  "vectorize": [
    { "binding": "VECTORIZE", "index_name": "rvkfoodie-content" }
  ],
  "ai": { "binding": "AI" },

  // Env model — vars are committed config; secrets are per-environment
  // values that never enter the repo.
  //
  // Top-level = production (default deploy env).
  //  - vars: ENVIRONMENT, ASSET_BASE_URL, BETTER_AUTH_URL (config values;
  //    BETTER_AUTH_URL is a public URL — not a secret).
  //  - secrets.required: the genuinely sensitive strings. `wrangler types`
  //    generates their types from this list (CI-safe), `wrangler dev` /
  //    `vite dev` load ONLY these keys from .dev.vars / .env / process.env
  //    (hangar injects them from the Keychain), and `wrangler deploy` FAILS
  //    if any is not configured on the Worker.
  //  - BETTER_AUTH_SECRET (session signing), CMS_WRITE_KEY (agent-cms
  //    writes), R2_ACCESS_KEY_ID + R2_SECRET_ACCESS_KEY (media bucket).
  //
  // Bindings are NON-INHERITABLE in wrangler, so `env.development` below
  // redeclares them; only `vars` differ from production.
  "vars": {
    "ENVIRONMENT": "production",
    "ASSET_BASE_URL": "https://media.rvkfoodie.is",
    "BETTER_AUTH_URL": "https://rvkfoodie.is"
  },
  "secrets": {
    "required": [
      "BETTER_AUTH_SECRET",
      "CMS_WRITE_KEY",
      "R2_ACCESS_KEY_ID",
      "R2_SECRET_ACCESS_KEY"
    ]
  },

  // Local dev env — selected by the Vite plugin via CLOUDFLARE_ENV
  // (hangar.toml sets it on the web run line). Only vars differ: the dev
  // origin for BETTER_AUTH_URL is the hangar hostname.
  "env": {
    "development": {
      "vars": {
        "ENVIRONMENT": "development",
        "ASSET_BASE_URL": "https://media.rvkfoodie.is",
        "BETTER_AUTH_URL": "https://web.rvkfoodie.localhost"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "rvkfoodie-cms-v4b",
          "database_id": "a243733a-4334-43d6-b22b-fc90ad2fc371",
          "migrations_dir": "drizzle",
          "migrations_pattern": "drizzle/*/migration.sql"
        }
      ],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "rvkfoodie-cms" }],
      "send_email": [{ "name": "EMAIL" }],
      "kv_namespaces": [
        {
          "binding": "PURCHASES",
          "id": "782842e31e944c38af1413c73fdcced2"
        }
      ],
      "vectorize": [
        { "binding": "VECTORIZE", "index_name": "rvkfoodie-content" }
      ],
      "ai": { "binding": "AI" }
    }
  }

}
